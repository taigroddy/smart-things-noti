<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ================================================
         QUYỀN CHO THÔNG BÁO ĐẨY KÈM NHẠC CHUÔNG TÙY CHỈNH
         ================================================ -->

    <!-- Nhận thông báo (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Đánh thức màn hình khi máy giặt xong -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Hiển thị thông báo dạng pop-up / full screen khi điện thoại khoá -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>

    <!-- Rung khi có thông báo máy giặt xong -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Kết nối internet để nhận FCM -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:label="Washer Notifier"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">

        <!-- Main Activity — hiển thị trên màn hình khoá khi có cuộc gọi giả -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showOnLockScreen="true"
            android:turnScreenOn="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <!-- Meta-data Firebase -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="washer_notifier_channel"/>

        <!-- Tắt notification mặc định của FCM (vì chúng ta tự xử lý qua Data Message) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher"/>

        <!-- FlutterActivity boilerplate -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>

    <!-- Truy vấn packages cần thiết cho ứng dụng Samsung SmartThings -->
    <queries>
        <package android:name="com.samsung.android.oneconnect" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="smartthings" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

</manifest>
