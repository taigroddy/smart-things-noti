# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỆ THỐNG
# ==========================================

# 1. Samsung SmartThings Personal Access Token (PAT)
# Tạo token tại: https://account.smartthings.com/tokens (yêu cầu quyền devices, installedapps, apps)
SMARTTHINGS_PAT=your_smartthings_personal_access_token_here

# 2. ID của thiết bị máy giặt Samsung trong SmartThings
# Lấy từ SmartThings API (GET /v1/devices) hoặc qua SmartThings Developer Workspace
SMARTTHINGS_WASHER_DEVICE_ID=your_washer_device_id_here

# 3. Firebase Service Account JSON (dạng chuỗi rút gọn trên 1 dòng để dễ truyền qua biến môi trường)
# Tải tệp JSON từ Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Ví dụ: {"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"}

# 4. Token thiết bị di động (FCM Device Registration Token) nhận thông báo
# Lấy từ ứng dụng di động phía client (FirebaseMessaging.getInstance().getToken())
FCM_DEVICE_TOKEN=your_fcm_device_registration_token_here

# 5. Đường link URL Webhook công khai (Bắt buộc dùng HTTPS theo chuẩn SmartThings)
# Khi chạy Docker cục bộ có thể dùng Cloudflare Tunnel / ngrok (vd: https://xxxx.trycloudflare.com/api/webhook)
# Khi deploy Vercel (vd: https://your-project.vercel.app/api/webhook)
WEBHOOK_TARGET_URL=https://your-domain.com/api/webhook

# Cổng lắng nghe cho Docker / Express server (mặc định: 3000)
PORT=3000

# ==========================================
# 6. Samsung SmartThings OAuth2 Credentials
# ==========================================
SMARTTHINGS_APP_ID=3db3b70c-e01a-46fa-882a-b20aa5c034cf
SMARTTHINGS_CLIENT_ID=d8e3097b-8bed-4a11-9689-25f6ec432fe4
SMARTTHINGS_CLIENT_SECRET=your_client_secret_here
SMARTTHINGS_REDIRECT_URI=https://smart-things-noti-81ql.vercel.app/api/auth/callback
SMARTTHINGS_OAUTH_SCOPES=r:devices:* x:devices:*

