  "author": "",
  "license": "MIT",
  "dependencies": {
    "@smartthings/smartapp": "^4.3.8",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
