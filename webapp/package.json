{
  "name": "smartthings-washer-fcm-webhook",
  "version": "1.0.0",
  "description": "SmartThings Webhook receiver and FCM Data-Only Push Notification sender deployable via Docker and Vercel",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup:subscription": "node scripts/setup-subscription.js",
    "test:ping": "node scripts/test-webhook.js ping",
    "test:confirm": "node scripts/test-webhook.js confirmation",
    "test:event": "node scripts/test-webhook.js event"
  },
  "keywords": [
    "smartthings",
    "samsung",
    "fcm",
    "firebase",
    "webhook",
    "push-notification",
